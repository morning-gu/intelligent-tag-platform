# 复制本文件为 .env 并填入真实值（make_llm_client 启动时经 load_dotenv 装入进程环境）。
# 完整环境变量清单见 README.md「环境变量」一节；其余 TAGPLT_* 配置见 src/tagplatform/settings.py。

# LLM 端点 Base URL（OpenAI 兼容端点地址，标签生成必需；未设置时任务生成报错并提示复制本文件）
OPENAI_BASE_URL=

# LLM API Key（与 OPENAI_BASE_URL 配套使用）
OPENAI_API_KEY=

# SQLite 数据库文件路径（alembic 迁移与应用启动共用；启动前必须先跑 alembic upgrade head）
TAGPLT_DATABASE_PATH=data/tagplatform.db

# 开放评测端点（留空的字段沿用主模型/网关配置）。
# TAGPLT_OPEN_EVAL_REVIEW_MODEL=
# TAGPLT_OPEN_EVAL_REVIEW_BASE_URL_ENV=OPENAI_BASE_URL
# TAGPLT_OPEN_EVAL_REVIEW_API_KEY_ENV=OPENAI_API_KEY
# 默认整片低强度评审。端点不支持 reasoning_effort 时把该变量设为空串。
# TAGPLT_OPEN_EVAL_REVIEW_REASONING_EFFORT=low
# TAGPLT_OPEN_EVAL_REVIEW_MAX_TOKENS=8192
# TAGPLT_OPEN_EVAL_REVIEW_CONCURRENCY=4

# 标签价值三方向权重（顺序：内容呈现,内容搜索,内容推荐；自动归一化，Judge 与开放评测共用）
# TAGPLT_TAG_VALUE_WEIGHTS_CONTENT=0.30,0.40,0.30
# TAGPLT_TAG_VALUE_WEIGHTS_SCENE=0.50,0.40,0.10
# TAGPLT_TAG_VALUE_WEIGHTS_CHARACTER=0.55,0.30,0.15
