# 复制本文件为 .env 并填入真实值（make_llm_client 启动时经 load_dotenv 装入进程环境）。
# 完整环境变量清单见 README.md「环境变量」一节；其余 TAGPLT_* 配置见 src/tagplatform/settings.py。

# LLM 端点 Base URL（OpenAI 兼容端点地址，标签生成必需；未设置时任务生成报错并提示复制本文件）
OPENAI_BASE_URL=

# LLM API Key（与 OPENAI_BASE_URL 配套使用）
OPENAI_API_KEY=

# SQLite 数据库文件路径（alembic 迁移与应用启动共用；启动前必须先跑 alembic upgrade head）
TAGPLT_DATABASE_PATH=data/tagplatform.db
